f esc(text: object) -> str :: Escape ``text`` (``str()`` of it when it is not a string) for HTML
f section(anchor: str, step: str, title: str, summary: str, body: str) -> str :: A collapsible phase card: a step mark, a title and a summary above its body
f chip(anchor: str, title: str, summary: str) -> str :: A flow chip linking to the phase card ``anchor``; its texts are escaped
f card(title: str, body: str) -> str :: A titled card; ``title`` is plain text, ``body`` is HTML already escaped
f grid(items: Sequence[tuple[str, str]]) -> str :: A label/value grid; the labels are plain text, the values are HTML
f table(headers: Sequence[tuple[str, bool]], body_rows: Sequence[str]) -> str :: A table; ``headers`` are ``(text, right-aligned)``, rows are ``<tr>`` HTML
f yes_no(value: bool | None) -> str :: A green ``sí``, a red ``no`` or a dash for ``None``
f status_pill(code: str | None, kind: Literal["rule", "judge", "generation"] = "rule") -> str :: A coloured pill with the Spanish label of ``code``; a dash for ``None``
f answer_html(text: str) -> str :: The answer text escaped, with bold and the ``[n]`` markers as chips
f json_block(value: Any) -> str :: ``value`` as an indented, escaped JSON text block
f json_script(element_id: str, value: Any) -> str :: ``value`` as a JSON ``<script>`` block that cannot close itself
f deep_link(*, doc: str | None = None, question: str | None = None, chunk: str | None = None, used: bool = False) -> str :: The href ``#chunks?doc=<source>&q=<id>&chunk=<chunk_id>`` of the explorer
f link(href: str, inner: str, css: str = "chunk-link") -> str :: An anchor to ``href`` (plain text, escaped) around ``inner`` (HTML)
f messages_block(messages: Sequence[Mapping[str, Any]]) -> str :: Chat messages as role-tagged text blocks; a note when there are none
f metric_label(score: str) -> str :: The Spanish label of ``score``, with `` ↓`` when a lower value is better
f seconds(value: float) -> str :: A duration with one decimal, as ``"4.2 s"``
f write_html(html: str, path: Path) ! RecordError ~io :: Write ``html`` as UTF-8 to ``path``, creating the parent folder
f page(title: str, meta: str, tabs: Sequence[tuple[str, str, str]], panels: Sequence[tuple[str, str]], data: str = "") -> str :: Assemble the self-contained document: styles and script inlined
