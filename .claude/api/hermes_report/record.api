# apigen-format: 2 | generated by apigen, do not edit
@mod hermes_report.record :: Run record: the schema of ``run.json``, its converters and its file I/O
@ext hermes_core, hermes_enrich

k SCHEMA_VERSION: Final = 2
k READABLE_SCHEMAS: Final = (1, 2)

C RecordError(Exception) :: The run record cannot be read or written (message in Spanish)
  m __init__(path: Path, message: str)
  a path
  a message

C VectorSummary(TypedDict) :: A vector reduced to its dimension, Euclidean norm and first values
  a dimension: int; norm: float; head: list[float]

C PointRecord(TypedDict) :: One Qdrant point: its id as a string, payload and vector summary
  a id: str; payload: dict[str, Any]; vector: VectorSummary | None

C DocumentRecord(TypedDict) :: One corpus document with its chunk count
  a source: str; sha256: str; chars: int; chunks: int

C CorpusRecord(TypedDict) :: The corpus folder and its documents
  a dir: str; glob: str; fingerprint: str; documents: list[DocumentRecord]

C IngestDocumentRecord(TypedDict) :: The ingestion of one document
  a source: str; chunks: int; seconds: float; cached: bool

C IngestRecord(TypedDict) :: The ingestion phase
  a seconds: float; chunker: dict[str, Any]; embedding: dict[str, Any]; ingester_version: str
  a documents: list[IngestDocumentRecord]

C CollectionRecord(TypedDict) :: The Qdrant collection the run used
  a name: str; url: str; reloaded: bool; points: int
  a vector_size: int; distance: str; indexes: list[str]

C EnvironmentRecord(TypedDict) :: Where the run happened: interpreter, packages and services
  a python: str; packages: dict[str, str]; ollama_host: str; qdrant_url: str

C RetrievedChunkRecord(TypedDict) :: A retrieved chunk; ``metadata`` is the payload without its ``text`` key
  a chunk_id: str; text: str; score: float; vector_score: float | None
  a collection_name: str; metadata: dict[str, Any]

C SearchedQueryRecord(TypedDict) :: A query that was embedded and searched
  a text: str; chain: list[str]

C RetrievalRecord(TypedDict) :: The retrieval phase of one question
  a seconds: float; chunks: list[RetrievedChunkRecord]; queries: list[SearchedQueryRecord]

C ChunkRefRecord(TypedDict) :: A chunk inside a context piece, with its provenance and no text
  a chunk_id: str; collection_name: str; source: str | None; doc_id: str | None
  a chunk_index: int | None; score: float | None; origin: list[str]

C PieceRecord(TypedDict) :: A contiguous block of context text
  a text: str; transforms: list[str]; chunks: list[ChunkRefRecord]

C ContextRecord(TypedDict) :: An enriched context
  a pieces: list[PieceRecord]; enrichments: list[str]; dropped_chunk_ids: list[str]; query_id: str | None

C ChunkRangeRecord(TypedDict) :: An inclusive range of chunk indexes of one document
  a collection_name: str; doc_id: str; first: int; last: int

C StoreReadRecord(TypedDict) :: One read of the vector store made by an enrichment step
  a ranges: list[ChunkRangeRecord]; returned: list[str]; seconds: float

C StepRecord(TypedDict) :: One enrichment step with the context before and after it
  a name: str; phase: str; seconds: float; before: ContextRecord
  a after: ContextRecord; reads: list[StoreReadRecord]

C EnrichRecord(TypedDict) :: The enrichment phase of one question
  a seconds: float; budget: dict[str, Any]; steps: list[StepRecord]; context: ContextRecord | None

C MessageRecord(TypedDict) :: One chat message
  a role: str; content: str

C LLMCallRecord(TypedDict) :: One call to a language model
  a messages: list[MessageRecord]; params: dict[str, Any]; reply: dict[str, Any] | None; error: str | None
  a seconds: float

C GenerationRecord(TypedDict) :: The generation phase of one question
  a seconds: float; llm_calls: list[LLMCallRecord]; result: dict[str, Any] | None

C RuleRecord(TypedDict) :: The rule-based verdict of one answer
  a verdict: str; in_retrieval: bool | None; in_context: bool | None; in_cited: bool | None
  a answer_ok: bool | None; retrieved_rank: int | None; expected_docs_retrieved: bool | None

C JudgeRecord(TypedDict) :: The LLM judge verdict of one answer
  a verdict: str | None; reason: str | None; model: str; seconds: float
  a messages: list[MessageRecord]; raw: str | None; error: str | None

C JudgeCallRecord(TypedDict) :: One judge call made by a metric operation
  a purpose: str; messages: list[MessageRecord]; raw: str | None; error: str | None
  a seconds: float

C MetricResultRecord(TypedDict) :: The outcome of one metric family for one question
  a name: str; status: str; scores: dict[str, float | None]; details: dict[str, Any]
  a calls: list[JudgeCallRecord]; error: str | None; seconds: float

C ScoreSummaryRecord(TypedDict) :: The aggregate of one score over a run
  a mean: float | None; n: int; not_applicable: int; skipped: int
  a errors: int

C MetricsRunRecord(TypedDict) :: The metrics of a run: what was selected and the mean of every score
  a selection: list[str]; scores: list[str]; summary: dict[str, ScoreSummaryRecord]

C QuestionRecord(TypedDict) :: Everything that happened to one question
  a spec: dict[str, Any]; query_id: str; seconds: float; error: str | None
  a retrieval: RetrievalRecord | None; enrich: EnrichRecord | None; generation: GenerationRecord | None; rules: RuleRecord | None
  a judge: JudgeRecord | None; metrics: list[MetricResultRecord] | None

C RunRecord(TypedDict) :: The whole run: the content of ``run.json``
  a schema: int; title: str; description: str; started_at: str
  a finished_at: str; seconds: float; config: dict[str, Any]; environment: EnvironmentRecord
  a corpus: CorpusRecord; ingest: IngestRecord; collection: CollectionRecord; points: list[PointRecord]
  a questions: list[QuestionRecord]; metrics: MetricsRunRecord | None

f json_safe(value: Any) -> Any :: Copy of ``value`` with every tuple turned into a list, recursively
f vector_summary(vector: Sequence[float]) -> VectorSummary :: Summarise a vector as its dimension, Euclidean norm and first 8 values
f point_record(point_id: str | int, payload: Mapping[str, Any], vector: Sequence[float] | None) -> PointRecord :: Record a Qdrant point with its id as a string and a summarised vector
f retrieved_chunk_record(chunk: RetrievedChunk) -> RetrievedChunkRecord :: Record a retrieved chunk; its metadata loses any ``text`` key
f searched_query_record(query: SearchedQuery) -> SearchedQueryRecord :: Record a searched query with its transform chain as a list
f context_record(context: EnrichedContext) -> ContextRecord :: Record an enriched context: pieces with their chunks, without chunk text
f chunk_range_record(chunk_range: ChunkRange) -> ChunkRangeRecord :: Record a chunk range
f message_record(message: PromptMessage) -> MessageRecord :: Record a prompt message
f generation_result_record(result: GenerationResult) -> dict[str, Any] :: Record a generation result as plain data that equals its JSON round trip
f write_record(record: RunRecord, path: Path) ! RecordError ~io :: Write the record as UTF-8 JSON, creating the parent folder
f read_record(path: Path) -> RunRecord ! RecordError ~io :: Read a run record; the object loaded is cast, not deeply validated
