  a seed: int | None = 42
  a response_format: str = "plain"
  a insufficient_message: str | None = None

D JudgeConfig [frozen] :: The ``[judge]`` section, with provider and model already resolved
  a enabled: bool; provider: str; model: str

D OutputConfig [frozen] :: The ``[output]`` section, with absolute paths
  a dir: Path; cache_dir: Path

D Overrides [frozen] :: Command-line values that replace run-file keys
  a model: str | None = None
