  a provider: str = "ollama"
  a model: str = "nomic-embed-text"

D QdrantConfig [frozen] :: The ``[qdrant]`` section; an empty collection means derived
  a url: str
  a collection: str = ""

D RetrievalConfig [frozen] :: The ``[retrieval]`` section
  a top_k: int = 10
  a candidate_factor: int = 1
  a score_threshold: float | None = None

D EnrichConfig [frozen] :: The ``[enrich]`` section; ``max_context_tokens`` 0 means no limit
